# =============================================================================
# Safe Signal Trader – Environment Example
# =============================================================================
# Copy to .env and fill in values. NEVER commit real secrets.
# Credentials are referenced by name only; actual values come from Env / Secret Manager.
# =============================================================================

# Application
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=true
CORRELATION_ID_HEADER=X-Correlation-ID

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://signalbot:signalbot@localhost:5432/signalbot
DATABASE_URL_SYNC=postgresql://signalbot:signalbot@localhost:5432/signalbot

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Safety / Environment Gates
LIVE_TRADING_ENABLED=false   # MUST be explicitly true for live; default false
ALLOW_TESTNET=true
MAX_GLOBAL_NOTIONAL_USDT=1000
MAX_DAILY_LOSS_USDT=100
GLOBAL_PAUSE=false

# Telegram (Ingestion) – only for later phases
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=

# Control Bot – only for later phases
# CONTROL_BOT_TOKEN=

# Exchange credential references (values never stored in DB/snapshots)
# BINANCE_DEMO_1_API_KEY=
# BINANCE_DEMO_1_API_SECRET=

# Observability
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL_SEC=30
